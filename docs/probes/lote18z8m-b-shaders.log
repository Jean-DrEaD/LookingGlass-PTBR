{
	// ioq3 GL_MODULATE multitexture: a collapsed second stage, or a white texel.
	rgb {
		spare0 = spare0.rgb * tex1.rgb;
	}
	alpha {
		spare0 = spare0.a * tex1.a;
	}
}

out.rgb = unsigned(spare0.rgb);
out.a = unsigned(spare0.a);
