148:                     light_uv: vec2(f32_at(s, 20)?, f32_at(s, 24)?),
149:                     color: s[40..44].try_into()?,
150:                 })
151:             })
152:             .collect::<Result<Vec<_>>>()?;
153:         let indices = records(lumps[5], 4)?
154:             .map(|s| count(s, 0))
155:             .collect::<Result<Vec<_>>>()?;
156:         ensure!(
157:             lumps[2].len() % (128 * 128 * 3) == 0,
158:             "Invalid lightmap lump"
159:         );
