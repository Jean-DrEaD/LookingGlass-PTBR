107: impl Bsp {
108:     pub fn parse(b: &[u8]) -> Result<Self> {
109:         ensure!(b.len() >= 172, "Truncated FAKK BSP header");
110:         ensure!(&b[..4] == b"FAKK", "Expected an Alice FAKK BSP");
111:         ensure!(
112:             i32_at(b, 4)? == 42,
113:             "Unsupported FAKK BSP version (expected 42)"
114:         );
115:         let mut lumps = Vec::new();
116:         let mut ranges = Vec::new();
117:         for i in 0..20 {
118:             let offset = count(b, 12 + i * 8)?;
119:             let length = count(b, 16 + i * 8)?;
120:             let range = bounded(offset, length, b.len())?;
121:             if length > 0 {
122:                 ensure!(offset >= 172, "Lump overlaps header");
123:                 ranges.push(range.clone());
124:             }
125:             lumps.push(&b[range]);
126:         }
127:         ranges.sort_by_key(|r| r.start);
128:         ensure!(
129:             ranges.windows(2).all(|w| w[0].end <= w[1].start),
130:             "Overlapping BSP lumps"
131:         );
132:         let shaders = records(lumps[0], 76)?
133:             .map(|s| {
134:                 let n = s[..64].iter().position(|&b| b == 0).unwrap_or(64);
135:                 Ok(Shader {
136:                     name: core::str::from_utf8(&s[..n])?.to_owned(),
137:                     flags: i32_at(s, 64)?,
138:                     contents: i32_at(s, 68)?,
139:                 })
140:             })
141:             .collect::<Result<Vec<_>>>()?;
142:         let vertices = records(lumps[4], 44)?
