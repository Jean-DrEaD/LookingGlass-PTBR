76: fn i32_at(b: &[u8], o: usize) -> Result<i32> {
77:     let end = o.checked_add(4).context("Offset overflow")?;
78:     Ok(i32::from_le_bytes(
79:         b.get(o..end).context("Truncated BSP field")?.try_into()?,
80:     ))
81: }
82: fn count(b: &[u8], o: usize) -> Result<usize> {
83:     usize::try_from(i32_at(b, o)?).context("Negative BSP count or offset")
84: }
85: fn f32_at(b: &[u8], o: usize) -> Result<f32> {
86:     let f = f32::from_bits(i32_at(b, o)? as u32);
87:     ensure!(f.is_finite(), "Non-finite BSP coordinate");
88:     Ok(f)
89: }
90: fn vec_at(b: &[u8], o: usize) -> Result<Vec3> {
91:     Ok(vec3(f32_at(b, o)?, f32_at(b, o + 4)?, f32_at(b, o + 8)?))
92: }
93: fn records(b: &[u8], stride: usize) -> Result<core::slice::ChunksExact<'_, u8>> {
94:     ensure!(
95:         b.len() % stride == 0,
96:         "Lump length {} is not a multiple of {stride}",
97:         b.len()
98:     );
99:     Ok(b.chunks_exact(stride))
100: }
101: fn bounded(first: usize, size: usize, total: usize) -> Result<core::ops::Range<usize>> {
102:     let end = first.checked_add(size).context("BSP range overflow")?;
103:     ensure!(end <= total, "BSP range {first}..{end} exceeds {total}");
104:     Ok(first..end)
105: }
