  152: static void Sys_XboxHidMatchMouseField(xboxHidMouseLayout_t *layout, uint32_t usage,
  153: 	const xboxHidGlobals_t *globals, uint32_t bitOffset, qboolean relative)
  154: {
  155: 	xboxHidField_t *field = NULL;
  156: 	if (usage >= HID_USAGE_BUTTON_1 && usage < HID_USAGE_BUTTON_1 + HID_MOUSE_BUTTONS)
  157: 		field = &layout->buttons[usage - HID_USAGE_BUTTON_1];
  158: 	else if (relative && usage == HID_USAGE_X)
  159: 		field = &layout->x;
  160: 	else if (relative && usage == HID_USAGE_Y)
  161: 		field = &layout->y;
  162: 	else if (relative && usage == HID_USAGE_WHEEL)
  163: 		field = &layout->wheel;
  164: 	if (field && !field->present)
  165: 		Sys_XboxHidSetField(field, globals->reportId, bitOffset,
  166: 			globals->reportSize, globals->logicalMin < 0);
  167: }
