  454: static void Sys_XboxHidKeyEvent(int time, int key, qboolean down, qboolean character)
  455: {
  456: 	if (!key) return;
  457: 	Com_QueueEvent(time, SE_KEY, key, down, 0, NULL);
  458: 	if (down && character && key >= 32 && key < 127)
  459: 		Com_QueueEvent(time, SE_CHAR, key, 0, 0, NULL);
  460: }
