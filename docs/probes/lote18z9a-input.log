  353: static void Sys_XboxHidRead(HID_DEV_T *device, uint16_t endpoint, int status,
  354: 	uint8_t *report, uint32_t length)
  355: {
  356: 	xboxHidState_t *state = device ? (xboxHidState_t *)device->user_data : NULL;
  357: 	(void)endpoint;
  358: 	if (!state || status || !report || !length)
  359: 		return;
  360: 	if (length > HID_REPORT_MAX)
  361: 		length = HID_REPORT_MAX;
  362: 	if (state->reportCount == 8)
  363: 	{
  364: 		state->reportHead = (state->reportHead + 1) & 7;
  365: 		--state->reportCount;
  366: 	}
  367: 	{
  368: 		int tail = (state->reportHead + state->reportCount) & 7;
  369: 		memcpy(state->reports[tail], report, length);
  370: 		state->reportLengths[tail] = (uint8_t)length;
  371: 		++state->reportCount;
  372: 	}
  373: 	if (state->protocol == HID_BOOT_MOUSE)
  374: 	{
  375: 		xboxHidMouseSample_t sample;
  376: 		Sys_XboxHidMouseDecode(&state->mouse, report, length, &sample);
  377: 		state->mouseX += sample.dx;
  378: 		state->mouseY += sample.dy;
  379: 	}
  380: }
