  333: static int Sys_XboxHidSlot(HID_DEV_T *device, qboolean allocate)
  334: {
  335: 	int i;
  336: 	for (i = 0; i < XBOX_HID_MAX_DEVICES; ++i)
  337: 		if (xboxHid[i].device == device && (!allocate || xboxHid[i].connected))
  338: 			return i;
  339: 	if (allocate)
  340: 		for (i = 0; i < XBOX_HID_MAX_DEVICES; ++i)
  341: 			if (!xboxHid[i].device)
  342: 			{
  343: 				memset(&xboxHid[i], 0, sizeof(xboxHid[i]));
  344: 				xboxHid[i].device = device;
  345: 				xboxHid[i].protocol = device->bProtocolCode;
  346: 				xboxHid[i].connected = qtrue;
  347: 				device->user_data = &xboxHid[i];
  348: 				return i;
  349: 			}
  350: 	return -1;
  351: }
