  654: static qboolean Sys_XboxInputButtonDown(const xboxControllerState_t *state,
  655: 	int button)
  656: {
  657: 	switch (button)
  658: 	{
  659: 	case XBOX_BTN_A:
  660: 		return state->a >= XBOX_BUTTON_THRESHOLD;
  661: 	case XBOX_BTN_B:
  662: 		return state->b >= XBOX_BUTTON_THRESHOLD;
  663: 	case XBOX_BTN_X:
  664: 		return state->x >= XBOX_BUTTON_THRESHOLD;
  665: 	case XBOX_BTN_Y:
  666: 		return state->y >= XBOX_BUTTON_THRESHOLD;
  667: 	case XBOX_BTN_BLACK:
  668: 		return state->black >= XBOX_BUTTON_THRESHOLD;
  669: 	case XBOX_BTN_WHITE:
  670: 		return state->white >= XBOX_BUTTON_THRESHOLD;
  671: 	case XBOX_BTN_LEFT_TRIGGER:
  672: 		return state->leftTrigger >= XBOX_BUTTON_THRESHOLD;
  673: 	case XBOX_BTN_RIGHT_TRIGGER:
  674: 		return state->rightTrigger >= XBOX_BUTTON_THRESHOLD;
  675: 	default:
  676: 		return (state->buttons & (1 << button)) != 0;
  677: 	}
  678: }
  679: 
  680: static int Sys_XboxInputKeyFor(int button, qboolean inMenu)
  681: {
  682: 	/* The menu UI only understands Enter and Escape for accept and back. */
  683: 	if (inMenu && button == XBOX_BTN_A)
  684: 		return K_ENTER;
  685: 	if (inMenu && button == XBOX_BTN_B)
  686: 		return K_ESCAPE;
  687: 	return xboxButtonKeys[button];
  688: }
