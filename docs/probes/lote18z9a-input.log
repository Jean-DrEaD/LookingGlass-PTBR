  462: static int Sys_XboxHidChar(uint8_t usage, qboolean shifted, qboolean caps)
  463: {
  464: 	int key = Sys_XboxHidKey(usage);
  465: 	/* ioq3 text fields erase on ctrl-h, which sdl_input.c sends for Backspace. */
  466: 	if (usage == 42)
  467: 		return 'h' - 'a' + 1;
  468: 	if (usage >= 4 && usage <= 29)
  469: 		return (shifted ^ caps) ? key - 'a' + 'A' : key;
  470: 	if (usage >= 30 && usage <= 39)
  471: 	{
  472: 		static const char shiftedDigits[] = "!@#$%^&*()";
  473: 		return shifted ? shiftedDigits[usage - 30] : (usage == 39 ? '0' : '1' + usage - 30);
  474: 	}
  475: 	if (usage >= 45 && usage <= 56)
  476: 	{
  477: 		static const char plain[] = "-=[]\\#;'`,./";
  478: 		static const char shiftedChars[] = "_+{}|~:\"~<>?";
  479: 		return shifted ? shiftedChars[usage - 45] : plain[usage - 45];
  480: 	}
  481: 	return key >= 32 && key < 127 ? key : 0;
  482: }
  483: 
  484: static void Sys_XboxHidFrame(int time)
  485: {
  486: 	int device;
  487: 	for (device = 0; device < XBOX_HID_MAX_DEVICES; ++device)
  488: 	{
  489: 		xboxHidState_t *state = &xboxHid[device];
  490: 		uint8_t reports[8][HID_REPORT_MAX];
  491: 		uint8_t reportLengths[8];
  492: 		uint8_t protocol;
  493: 		int reportCount, reportHead, mouseX, mouseY;
  494: 		int reportNumber;
  495: 		qboolean connected, devicePresent;
  496: 		KIRQL oldIrql;
  497: 		int i;
  498: 		oldIrql = KeRaiseIrqlToDpcLevel();
  499: 		devicePresent = state->device != NULL;
  500: 		connected = devicePresent && state->connected;
  501: 		protocol = state->protocol;
  502: 		reportHead = state->reportHead;
  503: 		reportCount = state->reportCount;
  504: 		mouseX = state->mouseX;
  505: 		mouseY = state->mouseY;
  506: 		state->reportHead = 0;
  507: 		state->reportCount = 0;
  508: 		state->mouseX = state->mouseY = 0;
  509: 		for (i = 0; i < reportCount; ++i)
  510: 		{
  511: 			int index = (reportHead + i) & 7;
  512: 			memcpy(reports[i], state->reports[index], HID_REPORT_MAX);
  513: 			reportLengths[i] = state->reportLengths[index];
  514: 		}
  515: 		KfLowerIrql(oldIrql);
  516: 		if (!devicePresent) continue;
  517: 		if (!connected)
  518: 		{
  519: 			for (i = 0; i < 32; ++i)
  520: 			{
  521: 				int bit;
  522: 				for (bit = 0; bit < 8; ++bit)
  523: 					if (state->oldUsages[i] & (1 << bit))
  524: 						Sys_XboxHidKeyEvent(time, (i * 8 + bit) == 53 ? K_CONSOLE : Sys_XboxHidKey((uint8_t)(i * 8 + bit)), qfalse, qfalse);
  525: 			}
  526: 			for (i = 0; i < 4; ++i)
  527: 				Sys_XboxHidKeyEvent(time, state->modifierKeys[i], qfalse, qfalse);
  528: 			for (i = 0; i < 5; ++i)
  529: 			{
  530: 				if (state->oldButtons & (1 << i))
  531: 					Sys_XboxInputKey(time, K_MOUSE1 + i, qfalse);
  532: 			}
  533: 			oldIrql = KeRaiseIrqlToDpcLevel();
  534: 			memset(state, 0, sizeof(*state));
  535: 			KfLowerIrql(oldIrql);
  536: 			continue;
  537: 		}
  538: 		for (reportNumber = 0; reportNumber < reportCount; ++reportNumber)
  539: 		{
  540: 			uint8_t *report = reports[reportNumber];
  541: 			uint32_t reportLength = reportLengths[reportNumber];
  542: 			if (protocol == HID_BOOT_KEYBOARD && reportLength >= 8)
  543: 			{
  544: 				uint8_t usages[32];
  545: 				qboolean shift = (report[0] & 0x22) != 0;
  546: 				memset(usages, 0, sizeof(usages));
  547: 				for (i = 0; i < 6; ++i)
  548: 				{
  549: 					int usage = report[2 + i];
  550: 					if (usage >= 1 && usage <= 3)
  551: 						break;
  552: 					usages[usage >> 3] |= (uint8_t)(1 << (usage & 7));
  553: 				}
  554: 				if (i != 6) continue;
  555: 				for (i = 0; i < 4; ++i)
  556: 				{
  557: 					static const int keys[] = { K_CTRL, K_SHIFT, K_ALT, K_COMMAND };
  558: 					int modifierMask = (1 << i) | (1 << (i + 4));
  559: 					int key = (report[0] & modifierMask) ? keys[i] : 0;
  560: 					if (key != state->modifierKeys[i])
  561: 					{
  562: 						Sys_XboxHidKeyEvent(time, state->modifierKeys[i], qfalse, qfalse);
  563: 						Sys_XboxHidKeyEvent(time, key, qtrue, qfalse);
  564: 						state->modifierKeys[i] = key;
  565: 					}
  566: 				}
  567: 				if ((usages[57 >> 3] & (1 << (57 & 7))) && !(state->oldUsages[57 >> 3] & (1 << (57 & 7))))
  568: 					state->capsLock = !state->capsLock;
  569: 				for (i = 0; i < 256; ++i)
  570: 				{
  571: 					uint8_t mask = (uint8_t)(1 << (i & 7));
  572: 					qboolean wasDown = (state->oldUsages[i >> 3] & mask) != 0;
  573: 					qboolean isDown = (usages[i >> 3] & mask) != 0;
  574: 					int key = i == 53 ? K_CONSOLE : Sys_XboxHidKey((uint8_t)i);
  575: 					if (wasDown != isDown)
  576: 					{
  577: 						Sys_XboxHidKeyEvent(time, key, isDown, qfalse);
  578: 						if (isDown && i != 53)
  579: 						{
  580: 							int character = Sys_XboxHidChar((uint8_t)i, shift, state->capsLock);
  581: 							if (character) Com_QueueEvent(time, SE_CHAR, character, 0, 0, NULL);
  582: 						}
  583: 					}
  584: 				}
  585: 				memcpy(state->oldUsages, usages, sizeof(usages));
  586: 			}
  587: 			else if (protocol == HID_BOOT_MOUSE)
  588: 			{
  589: 				xboxHidMouseSample_t sample;
  590: 				uint8_t buttons;
  591: 				int wheel;
  592: 				Sys_XboxHidMouseDecode(&state->mouse, report, reportLength, &sample);
  593: 				/* Keep buttons this report does not carry, e.g. another report ID. */
  594: 				buttons = (uint8_t)((state->oldButtons & ~sample.buttonMask) | sample.buttons);
  595: 				for (i = 0; i < 5; ++i)
  596: 					if ((buttons ^ state->oldButtons) & (1 << i))
  597: 						Sys_XboxInputKey(time, K_MOUSE1 + i, (buttons & (1 << i)) != 0);
  598: 				state->oldButtons = buttons;
  599: 				wheel = sample.wheel;
  600: 				while (wheel > 0)
  601: 				{
  602: 					Sys_XboxInputKey(time, K_MWHEELUP, qtrue);
  603: 					Sys_XboxInputKey(time, K_MWHEELUP, qfalse);
  604: 					--wheel;
  605: 				}
  606: 				while (wheel < 0)
  607: 				{
  608: 					Sys_XboxInputKey(time, K_MWHEELDOWN, qtrue);
  609: 					Sys_XboxInputKey(time, K_MWHEELDOWN, qfalse);
  610: 					++wheel;
  611: 				}
  612: 			}
  613: 		}
  614: 		if (protocol == HID_BOOT_MOUSE && (mouseX || mouseY))
  615: 		{
  616: 			Com_QueueEvent(time, SE_MOUSE, mouseX, mouseY, 0, NULL);
  617: 		}
  618: 	}
  619: }
  620: 
  621: static int Sys_XboxInputStick(int value)
  622: {
  623: 	int magnitude = value < 0 ? -value : value;
  624: 
  625: 	if (magnitude <= XBOX_STICK_DEADZONE)
  626: 		return 0;
  627: 	if (magnitude > XBOX_STICK_MAX)
  628: 		magnitude = XBOX_STICK_MAX;
  629: 	/* Rescale so output starts at 0 right after the deadzone. */
  630: 	magnitude = (magnitude - XBOX_STICK_DEADZONE) * XBOX_STICK_MAX /
  631: 		(XBOX_STICK_MAX - XBOX_STICK_DEADZONE);
  632: 	return value < 0 ? -magnitude : magnitude;
  633: }
  634: 
  635: static float Sys_XboxInputCursorStep(int stick, int frameMs)
  636: {
  637: 	float f = (float)stick / (float)XBOX_STICK_MAX;
  638: 
  639: 	/* Squared response gives finer control near center. */
  640: 	return f * (f < 0.0f ? -f : f) * XBOX_MENU_CURSOR_SPEED *
  641: 		(float)frameMs * 0.001f;
  642: }
