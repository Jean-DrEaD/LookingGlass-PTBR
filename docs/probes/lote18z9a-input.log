  417: static int Sys_XboxHidKey(uint8_t usage)
  418: {
  419: 	if (usage >= 4 && usage <= 29)
  420: 		return 'a' + usage - 4;
  421: 	if (usage >= 30 && usage <= 38)
  422: 		return '1' + usage - 30;
  423: 	if (usage == 39) return '0';
  424: 	if (usage >= 40 && usage <= 52)
  425: 	{
  426: 		static const int keys[] = { K_ENTER, K_ESCAPE, K_BACKSPACE, K_TAB, K_SPACE,
  427: 			'-', '=', '[', ']', '\\', '#', ';', '\'' };
  428: 		return keys[usage - 40];
  429: 	}
  430: 	if (usage >= 58 && usage <= 69) return K_F1 + usage - 58;
  431: 	switch (usage)
  432: 	{
  433: 	case 70: return K_PRINT; case 71: return K_SCROLLOCK; case 72: return K_PAUSE;
  434: 	case 73: return K_INS; case 74: return K_HOME; case 75: return K_PGUP;
  435: 	case 76: return K_DEL; case 77: return K_END; case 78: return K_PGDN;
  436: 	case 79: return K_RIGHTARROW; case 80: return K_LEFTARROW;
  437: 	case 81: return K_DOWNARROW; case 82: return K_UPARROW;
  438: 	case 83: return K_KP_NUMLOCK; case 84: return K_KP_SLASH;
  439: 	case 85: return K_KP_STAR; case 86: return K_KP_MINUS;
  440: 	case 87: return K_KP_PLUS; case 88: return K_KP_ENTER;
  441: 	case 89: return K_KP_END; case 90: return K_KP_DOWNARROW;
  442: 	case 91: return K_KP_PGDN; case 92: return K_KP_LEFTARROW;
  443: 	case 93: return K_KP_5; case 94: return K_KP_RIGHTARROW;
  444: 	case 95: return K_KP_HOME; case 96: return K_KP_UPARROW;
  445: 	case 97: return K_KP_PGUP; case 98: return K_KP_INS;
  446: 	case 99: return K_KP_DEL; case 103: return K_KP_EQUALS;
  447: 	case 53: return K_CONSOLE;
  448: 	case 57: return K_CAPSLOCK;
  449: 	case 54: return ','; case 55: return '.'; case 56: return '/';
  450: 	default: return 0;
  451: 	}
  452: }
