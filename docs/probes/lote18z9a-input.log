  382: static void Sys_XboxHidConnected(HID_DEV_T *device, int param)
  383: {
  384: 	int slot;
  385: 	uint8_t protocol = HID_PROTOCOL_BOOT;
  386: 	(void)param;
  387: 	if (!device || (device->bProtocolCode != HID_BOOT_KEYBOARD &&
  388: 		device->bProtocolCode != HID_BOOT_MOUSE))
  389: 		return;
  390: 	slot = Sys_XboxHidSlot(device, qtrue);
  391: 	if (slot < 0)
  392: 		return;
  393: 	/* Some mice ignore boot protocol, so decode their own layout in report protocol. */
  394: 	if (device->bProtocolCode == HID_BOOT_MOUSE &&
  395: 		Sys_XboxHidReadMouseLayout(device, &xboxHid[slot].mouse))
  396: 		protocol = HID_PROTOCOL_REPORT;
  397: 	/* Boot protocol gives the standard 8-byte keyboard and 3-byte mouse reports. */
  398: 	(void)usbh_hid_set_protocol(device, protocol);
  399: 	(void)usbh_hid_start_int_read(device, 0, Sys_XboxHidRead);
  400: }
  401: 
  402: static void Sys_XboxHidDisconnected(HID_DEV_T *device, int param)
  403: {
  404: 	int slot = Sys_XboxHidSlot(device, qfalse);
  405: 	(void)param;
  406: 	if (slot >= 0)
  407: 	{
  408: 		xboxHid[slot].connected = qfalse;
  409: 		xboxHid[slot].reportHead = 0;
  410: 		xboxHid[slot].reportCount = 0;
  411: 		xboxHid[slot].mouseX = xboxHid[slot].mouseY = 0;
  412: 	}
  413: 	if (device)
  414: 		device->user_data = NULL;
  415: }
