  141: static void Sys_XboxHidBootMouseLayout(xboxHidMouseLayout_t *layout)
  142: {
  143: 	int i;
  144: 	memset(layout, 0, sizeof(*layout));
  145: 	for (i = 0; i < HID_MOUSE_BUTTONS; ++i)
  146: 		Sys_XboxHidSetField(&layout->buttons[i], 0, i, 1, qfalse);
  147: 	Sys_XboxHidSetField(&layout->x, 0, 8, 8, qtrue);
  148: 	Sys_XboxHidSetField(&layout->y, 0, 16, 8, qtrue);
  149: 	Sys_XboxHidSetField(&layout->wheel, 0, 24, 8, qtrue);
  150: }
