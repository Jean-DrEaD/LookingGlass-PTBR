  169: /* Finds the button, X, Y and wheel fields in a HID 1.11 report descriptor. */
  170: static qboolean Sys_XboxHidParseMouse(const uint8_t *desc, int length,
  171: 	xboxHidMouseLayout_t *layout)
  172: {
  173: 	xboxHidGlobals_t globals, stack[HID_PARSE_STACK];
  174: 	uint32_t usages[HID_PARSE_USAGES];
  175: 	uint32_t inputBits[256];
  176: 	uint32_t usageMin = 0;
  177: 	int usageCount = 0, stackDepth = 0, pos = 0;
  178: 
  179: 	memset(layout, 0, sizeof(*layout));
  180: 	memset(&globals, 0, sizeof(globals));
  181: 	memset(inputBits, 0, sizeof(inputBits));
  182: 	while (pos < length)
  183: 	{
  184: 		uint8_t prefix = desc[pos++];
  185: 		int size = (prefix & 3) == 3 ? 4 : prefix & 3;
  186: 		int type = (prefix >> 2) & 3;
  187: 		int tag = prefix >> 4;
  188: 		uint32_t value = 0;
  189: 		int32_t signedValue;
  190: 		int i;
  191: 
  192: 		if (prefix == 0xFE)
  193: 		{
  194: 			/* Long item: a data size byte and a tag byte come before the data. */
  195: 			if (pos >= length)
  196: 				return qfalse;
  197: 			pos += 2 + desc[pos];
  198: 			continue;
  199: 		}
  200: 		if (pos + size > length)
  201: 			return qfalse;
  202: 		for (i = 0; i < size; ++i)
  203: 			value |= (uint32_t)desc[pos + i] << (8 * i);
  204: 		pos += size;
  205: 		signedValue = size == 1 ? (int8_t)value : size == 2 ? (int16_t)value : (int32_t)value;
  206: 
  207: 		if (type == 1)
  208: 		{
  209: 			switch (tag)
  210: 			{
  211: 			case 0x0: globals.usagePage = value; break;
  212: 			case 0x1: globals.logicalMin = signedValue; break;
  213: 			case 0x7: globals.reportSize = value; break;
  214: 			case 0x8: globals.reportId = value & 0xFF; layout->reportIds = qtrue; break;
  215: 			case 0x9: globals.reportCount = value; break;
  216: 			case 0xA: if (stackDepth < HID_PARSE_STACK) stack[stackDepth++] = globals; break;
  217: 			case 0xB: if (stackDepth > 0) globals = stack[--stackDepth]; break;
  218: 			default: break;
  219: 			}
  220: 		}
  221: 		else if (type == 2)
  222: 		{
  223: 			if (tag == 0x0 && usageCount < HID_PARSE_USAGES)
  224: 				usages[usageCount++] = value;
  225: 			else if (tag == 0x1)
  226: 				usageMin = value;
  227: 			else if (tag == 0x2)
  228: 			{
  229: 				uint32_t usage;
  230: 				for (usage = usageMin; usage <= value && usageCount < HID_PARSE_USAGES; ++usage)
  231: 					usages[usageCount++] = usage;
  232: 			}
  233: 		}
  234: 		else if (type == 0)
  235: 		{
  236: 			/* Input flags: bit 0 constant, bit 1 variable, bit 2 relative. */
  237: 			if (tag == 0x8)
  238: 			{
  239: 				if (!(value & 1) && (value & 2) && usageCount &&
  240: 					globals.reportSize >= 1 && globals.reportSize <= 32)
  241: 				{
  242: 					for (i = 0; i < (int)globals.reportCount && i < HID_PARSE_USAGES; ++i)
  243: 					{
  244: 						uint32_t usage = usages[i < usageCount ? i : usageCount - 1];
  245: 						/* A usage shorter than 4 bytes takes the page in effect here. */
  246: 						if (!(usage >> 16))
  247: 							usage |= globals.usagePage << 16;
  248: 						Sys_XboxHidMatchMouseField(layout, usage, &globals,
  249: 							inputBits[globals.reportId] + (uint32_t)i * globals.reportSize,
  250: 							(value & 4) != 0);
  251: 					}
  252: 				}
  253: 				inputBits[globals.reportId] += globals.reportSize * globals.reportCount;
  254: 			}
  255: 			usageCount = 0;
  256: 			usageMin = 0;
  257: 		}
  258: 	}
  259: 	return layout->x.present && layout->y.present;
  260: }
