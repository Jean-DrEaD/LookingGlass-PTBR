  279: static qboolean Sys_XboxHidFieldValue(const xboxHidField_t *field, qboolean reportIds,
  280: 	const uint8_t *report, uint32_t length, int *value)
  281: {
  282: 	uint32_t raw = 0;
  283: 	uint32_t i;
  284: 
  285: 	if (!field->present)
  286: 		return qfalse;
  287: 	if (reportIds)
  288: 	{
  289: 		if (!length || report[0] != field->reportId)
  290: 			return qfalse;
  291: 		++report;
  292: 		--length;
  293: 	}
  294: 	if (field->bitOffset >= length * 8 || field->bitSize > length * 8 - field->bitOffset)
  295: 		return qfalse;
  296: 	for (i = 0; i < field->bitSize; ++i)
  297: 	{
  298: 		uint32_t bit = field->bitOffset + i;
  299: 		if (report[bit >> 3] & (1 << (bit & 7)))
  300: 			raw |= 1u << i;
  301: 	}
  302: 	if (field->isSigned && field->bitSize < 32 && (raw & (1u << (field->bitSize - 1))))
  303: 		raw |= ~0u << field->bitSize;
  304: 	*value = (int)raw;
  305: 	return qtrue;
  306: }
