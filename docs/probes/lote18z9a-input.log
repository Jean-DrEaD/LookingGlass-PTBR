  308: /* Also runs in the USB DPC, so it only reads the report and the fixed layout. */
  309: static void Sys_XboxHidMouseDecode(const xboxHidMouseLayout_t *layout,
  310: 	const uint8_t *report, uint32_t length, xboxHidMouseSample_t *sample)
  311: {
  312: 	int value;
  313: 	int i;
  314: 
  315: 	memset(sample, 0, sizeof(*sample));
  316: 	if (Sys_XboxHidFieldValue(&layout->x, layout->reportIds, report, length, &value))
  317: 		sample->dx = value;
  318: 	if (Sys_XboxHidFieldValue(&layout->y, layout->reportIds, report, length, &value))
  319: 		sample->dy = value;
  320: 	if (Sys_XboxHidFieldValue(&layout->wheel, layout->reportIds, report, length, &value))
  321: 		sample->wheel = value;
  322: 	for (i = 0; i < HID_MOUSE_BUTTONS; ++i)
  323: 	{
  324: 		if (Sys_XboxHidFieldValue(&layout->buttons[i], layout->reportIds, report, length, &value))
  325: 		{
  326: 			sample->buttonMask |= 1 << i;
  327: 			if (value)
  328: 				sample->buttons |= 1 << i;
  329: 		}
  330: 	}
  331: }
