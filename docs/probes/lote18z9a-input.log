  262: static qboolean Sys_XboxHidReadMouseLayout(HID_DEV_T *device, xboxHidMouseLayout_t *layout)
  263: {
  264: 	/* Control transfers need DMA-safe memory from the USB pool. */
  265: 	uint8_t *desc = (uint8_t *)usbh_alloc_mem(HID_DESCRIPTOR_MAX);
  266: 	qboolean parsed = qfalse;
  267: 
  268: 	if (desc)
  269: 	{
  270: 		int length = usbh_hid_get_report_descriptor(device, desc, HID_DESCRIPTOR_MAX);
  271: 		parsed = length > 0 && Sys_XboxHidParseMouse(desc, length, layout);
  272: 		usbh_free_mem(desc, HID_DESCRIPTOR_MAX);
  273: 	}
  274: 	if (!parsed)
  275: 		Sys_XboxHidBootMouseLayout(layout);
  276: 	return parsed;
  277: }
