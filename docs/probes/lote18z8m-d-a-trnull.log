 124: static float lg2d_c01(float v) { return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v); }
 125: static DWORD lg2d_mk(int shader) {
 126:     float r = 1.0f, g = 1.0f, b = 1.0f, a = lg2d_c01(lg2d_rgba[3]);
 127:     if (shader <= 0) lg2d_nsh0++;
 128:     if (shader > 0) {
 129:         unsigned int h = (unsigned int)shader * 2654435761u;
 130:         r = 0.3f + (float)((h >> 8) & 0xFF) / 365.0f;
 131:         g = 0.3f + (float)((h >> 16) & 0xFF) / 365.0f;
 132:         b = 0.3f + (float)((h >> 24) & 0xFF) / 365.0f;
 133:     }
 134:     r = lg2d_c01(r * lg2d_rgba[0]); g = lg2d_c01(g * lg2d_rgba[1]); b = lg2d_c01(b * lg2d_rgba[2]);
 135:     return ((DWORD)(a * 255.0f) << 24) | ((DWORD)(r * 255.0f) << 16) | ((DWORD)(g * 255.0f) << 8) | (DWORD)(b * 255.0f);
 136: }
