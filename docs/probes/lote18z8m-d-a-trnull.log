  76: static char lg2d_probe(const char *name, int idx) {
  77:     char base[80]; void *buf = 0; long len; const unsigned char *b; size_t n;
  78:     if (!lg_ri_ok || !lg_ri.FS_ReadFile || !name) return '?';
  79:     Q_strncpyz(base, name, sizeof(base)); n = strlen(base);
  80:     if (n >= 4 && base[n - 4] == '.') base[n - 4] = 0;
  81:     Q_strncpyz(lg_tga_last, name, sizeof(lg_tga_last));
  82:     len = lg2d_try(base, ".tga", &buf);
  83:     if (len >= 18 && buf) {
  84:         b = (const unsigned char *)buf; lg_tga_ok++;
  85:         lg_tga_t = b[2]; lg_tga_w = b[12] | (b[13] << 8); lg_tga_h = b[14] | (b[15] << 8); lg_tga_bpp = b[16];
  86:         lg2d_decode(idx, b, len);
  87:         lg_ri.FS_FreeFile(buf); return 'T';
  88:     }
  89:     if (buf) lg_ri.FS_FreeFile(buf);
  90:     len = lg2d_try(base, ".jpg", &buf);
  91:     if (len > 0 && buf) { lg_tga_ok++; lg_ri.FS_FreeFile(buf); return 'J'; }
  92:     if (buf) lg_ri.FS_FreeFile(buf);
