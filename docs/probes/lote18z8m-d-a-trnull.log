  55: static void lg2d_decode(int idx, const unsigned char *b, long len) {
  56:     int t = b[2], w = b[12] | (b[13] << 8), h = b[14] | (b[15] << 8), bp = b[16] / 8;
  57:     int top = (b[17] & 0x20) != 0, i = 0, n, y, x;
  58:     const unsigned char *p = b + 18 + b[0], *end = b + len; unsigned int *o;
  59:     if ((t != 2 && t != 10) || (bp != 3 && bp != 4) || w <= 0 || h <= 0 || w > 256 || h > 256 || idx < 0 || idx >= 512) return;
  60:     n = w * h; o = (unsigned int *)malloc((size_t)n * 4); if (!o) return;
  61:     while (i < n && p < end) {
  62:         int cnt = 1, rle = 0;
  63:         if (t == 10) { cnt = (*p & 0x7f) + 1; rle = *p & 0x80; p++; }
  64:         if (rle) { unsigned int px; if (p + bp > end) break; px = lg2d_px(p, bp); p += bp; while (cnt-- && i < n) o[i++] = px; }
  65:         else { while (cnt-- && i < n) { if (p + bp > end) { i = n; break; } o[i++] = lg2d_px(p, bp); p += bp; } }
  66:     }
  67:     if (!top) for (y = 0; y < h / 2; y++) for (x = 0; x < w; x++) {
  68:         unsigned int tmp = o[y * w + x]; o[y * w + x] = o[(h - 1 - y) * w + x]; o[(h - 1 - y) * w + x] = tmp; }
  69:     lg_img[idx] = o; lg_iw[idx] = w; lg_ih[idx] = h; lg_ndec++;
  70: }
  71: static long lg2d_try(const char *base, const char *ext, void **buf) {
