## ===== maps/cinematics/centipede1_cinematics.scr (3736 bytes) =====
// VOID

float brave_ants = 0;
float brave_killer = 0;

void Centipede1_Cinematics_Init()
	{
		// INITIALIZE DIALOG WINDOWS
		Init_Dialog();

		// SETUP CAMERA PATHS
		cam.load( "centipede1_path1" );

		// SETUP ACTORS
		$centipede_actor1.maxmouthangle( 45 );
		$centipede_actor1.ai_off();
		$centipede_actor1.hide();
		$ant_runner1.ai_off();
		$ant_runner2.ai_off();
		$ant_runner3.ai_off();
	}

void Centipede1_Brave_Killer_Killed()
{
	brave_killer -= 1;
}

void Centipede1_Brave_Killer()
{
	while( 1 )
	{
		if( brave_ants < 3 )
		{
			trigger( "$brave_killer1" );
			wait( 0.1 );

			brave_killer += 1;

			$ant_killer.killthread( "Centipede1_Brave_Killer_Killed" );
			$ant_killer.attackplayer();
		}

		wait( 3.0 );
	}
}

void Centipede1_Brave_Ants_Killed()
{
	brave_ants -= 1;
}

void Centipede1_Brave_Ants()
{
	while( 1 )
	{
		if( brave_ants < 3 )
		{
			trigger( "$brave_spawn1" );
			wait( 0.1 );

			brave_ants += 1;

			$ant_attack.killthread( "Centipede1_Brave_Ants_Killed" );
			$ant_attack.attackplayer();
		}

		wait( 3.0 );
	}
}

void Centipede1_BraveAttack()
	{
		$ant_runner1.runto_pathnode( "$ant_brave_pos1" );
		$ant_runner2.runto_pathnode( "$ant_brave_pos2" );
		$ant_runner3.runto_pathnode( "$ant_brave_pos3" );
	}

void Centipede1_Talk1()
	{
		dialogtext.dt_clear();
		dialogtext.dt_fadetime(4);
		$centipede_actor1.playdialog( "sound/character/centipede/vo/cpd001.wav" );
		waitForDialog( $centipede_actor1, 1 );
	}

void Centipede1_Cinematic_Fakeplayer()
	{
		$player.hideweapon( 1 );
		fakeplayer();
		$fakeplayer.rendereffects( "+betterlighting" );
	}

void Centipede1_CentAnims()
	{
		$centipede_actor1.anim( "idle_yawn" );
		waitfor( $centipede_actor1 );
		$centipede_actor1.anim( "idle_snarl" );
		waitfor( $centipede_actor1 );
	}

void C1_End()
	{
		level_ai( 0 );
		cam_fadeout( .5, 1, 1, 1, 1, 0 );
		wait( .5 );
		$centipede_actor1.remove();
		End_Cinematic_Fast();
		cam_fadein( .5, 1, 1, 1, 1, 0 );
		level_ai( 1 );
		$ant_runner1.ai_on();
		$ant_runner2.ai_on();
		$ant_runner3.ai_on();
		$player.minhealth( 10 );
		trigger( "$ant_at_end1" );
		trigger( "$ant_at_end2" );
		thread Centipede1_Brave_Ants();
		thread Centipede1_Brave_Killer();
		wait( 4 );
		map( "centipede2$centipede2_start1" );
	}

void Skipthread_C1()
	{
		skipthread( "Null" );
		killthread( "Centipede1_Ambush_Cinema1" );
		killthread( "Centipede1_CentAnims" );
		thread C1_End();
	}

void Centipede1_Ambush_Cinema1()
	{
		level_ai( 0 );
		$ant_runner1.runto_pathnode( "$ant_brave_pos1" );
		$ant_runner2.runto_pathnode( "$ant_brave_pos2" );
		$ant_runner3.runto_pathnode( "$ant_brave_pos3" );
		wait( 2 );
		Centipede1_Cinematic_Fakeplayer();
		Start_Cinematic();
		skipthread( "Skipthread_C1" );
		wait( .5 );
		cam_fadeout( .5, 1, 1, 1, 1, 0 );
		wait( .5 );
		$centipede_actor1.show();
		$centipede_actor1.warpto( "$cent_posx1" );
		$alice_watch1.follow( $centipede1_path1 );
		$alice_watch1.cut();
		cuecamera( $alice_watch1, 0 );
		cam_fadein( .5, 1, 1, 1, 1, 0 );
		thread Centipede1_CentAnims();
		dialogtext.dt_clear();
		dialogtext.dt_fadetime(4);
		$centipede_actor1.playdialog( "sound/character/centipede/vo/cpd002.wav" );
		waitForDialog( $centipede_actor1, 1 );
		cam_fadeout( .5, 1, 1, 1, 1, 0 );
		wait( .5 );
		$centipede_actor1.remove();
		cam_fadein( .5, 1, 1, 1, 1, 0 );
		End_Cinematic_Fast();
		level_ai( 1 );
		$ant_runner1.ai_on();
		$ant_runner2.ai_on();
		$ant_runner3.ai_on();
		$player.minhealth( 10 );
		thread Centipede1_Brave_Ants();
		thread Centipede1_Brave_Killer();
		wait( 10 );
		map( "centipede2$centipede2_start1" );
	}

