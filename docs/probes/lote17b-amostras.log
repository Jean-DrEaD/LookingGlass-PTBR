void ArmLadies()
{
	string bugname;
	entity bug;
	float  i;

	while (1)
	{
		for ( i=1; i<5; i++ )
		{
			bugname = "lady" + i;
			bug = getentity( bugname );

			bug.checkreload();
		}

		wait(2);
	}
}

void Centipede1_Enemies_Init()
	{
		thread ArmLadies();
	}

