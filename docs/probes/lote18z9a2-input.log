  848: void Sys_XboxInputPoll(void)
  849: {
  850: 	if (!xboxInputStarted)
  851: 		return;
  852: 	/* Required by nxdk for enumeration and hot-plug detection. */
  853: 	usbh_pooling_hubs();
  854: }
