  814: qboolean Sys_XboxInputInit(void)
  815: {
  816: 	if (xboxInputStarted)
  817: 		return qtrue;
  818: 
  819: 	memset(xboxControllers, 0, sizeof(xboxControllers));
  820: 	memset(xboxHid, 0, sizeof(xboxHid));
  821: 	memset(xboxSentKey, 0, sizeof(xboxSentKey));
  822: 	memset(xboxSentAxis, 0, sizeof(xboxSentAxis));
  823: 	xboxCursorX = 0.0f;
  824: 	xboxCursorY = 0.0f;
  825: 	xboxLastFrameTime = Sys_Milliseconds();
  826: 	xboxInputStopping = qfalse;
  827: 	/* USB core initialization clears the driver table, so initialize it first. */
  828: 	usbh_core_init();
  829: 	usbh_xid_init();
  830: 	usbh_hid_init();
  831: 	usbh_install_xid_conn_callback(Sys_XboxInputConnected,
  832: 		Sys_XboxInputDisconnected);
  833: 	usbh_install_hid_conn_callback(Sys_XboxHidConnected,
  834: 		Sys_XboxHidDisconnected);
  835: 
  836: 	/* Enumerate controllers that were already connected at startup. */
  837: 	for (int i = 0; i < 500; ++i)
  838: 	{
  839: 		usbh_pooling_hubs();
  840: 		Sys_Sleep(1);
  841: 	}
  842: 
  843: 	Sys_XboxInputApplyDefaults();
  844: 	xboxInputStarted = qtrue;
  845: 	return qtrue;
  846: }
