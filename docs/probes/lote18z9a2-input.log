  726: static xboxControllerState_t *Sys_XboxInputSlot(xid_dev_t *device)
  727: {
  728: 	int i;
  729: 
  730: 	if (device->user_data)
  731: 		return (xboxControllerState_t *)device->user_data;
  732: 
  733: 	for (i = 0; i < XBOX_CONTROLLER_PORTS; ++i)
  734: 	{
  735: 		if (!xboxControllers[i].connected)
  736: 		{
  737: 			device->user_data = &xboxControllers[i];
  738: 			xboxControllers[i].connected = qtrue;
  739: 			return &xboxControllers[i];
  740: 		}
  741: 	}
  742: 
  743: 	return NULL;
  744: }
