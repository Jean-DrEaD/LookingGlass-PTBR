  856: void Sys_XboxInputFrame(void)
  857: {
  858: 	int port;
  859: 	int i;
  860: 	int time;
  861: 	int frameMs;
  862: 	qboolean inMenu;
  863: 
  864: 	if (!xboxInputStarted)
  865: 		return;
  866: 
  867: 	Sys_XboxInputPoll();
  868: 	time = Sys_Milliseconds();
  869: 	frameMs = time - xboxLastFrameTime;
  870: 	xboxLastFrameTime = time;
  871: 	if (frameMs < 0)
  872: 		frameMs = 0;
  873: 	if (frameMs > XBOX_FRAME_MAX_MS)
  874: 		frameMs = XBOX_FRAME_MAX_MS;
  875: 	inMenu = (Key_GetCatcher() & (KEYCATCH_UI | KEYCATCH_CGAME)) != 0;
  876: 	if (!inMenu)
  877: 	{
  878: 		xboxCursorX = 0.0f;
  879: 		xboxCursorY = 0.0f;
  880: 	}
  881: 
  882: 	for (port = 0; port < XBOX_CONTROLLER_PORTS; ++port)
  883: 	{
  884: 		const xboxControllerState_t *state = &xboxControllers[port];
  885: 		int stick[4];
  886: 
  887: 		for (i = 0; i < XBOX_BTN_COUNT; ++i)
  888: 		{
  889: 			qboolean down = Sys_XboxInputButtonDown(state, i);
  890: 			int *sent = &xboxSentKey[port][i];
  891: 
  892: 			if (down && !*sent)
  893: 			{
  894: 				*sent = Sys_XboxInputKeyFor(i, inMenu);
  895: 				Sys_XboxInputKey(time, *sent, qtrue);
  896: 			}
  897: 			else if (!down && *sent)
  898: 			{
  899: 				Sys_XboxInputKey(time, *sent, qfalse);
  900: 				*sent = 0;
  901: 			}
  902: 		}
  903: 
  904: 		/* XID reports Y up as positive; Quake expects down as positive. */
  905: 		stick[0] = Sys_XboxInputStick(state->leftStickX);
  906: 		stick[1] = -Sys_XboxInputStick(state->leftStickY);
  907: 		stick[2] = Sys_XboxInputStick(state->rightStickX);
  908: 		stick[3] = -Sys_XboxInputStick(state->rightStickY);
  909: 
  910: 		if (inMenu)
  911: 		{
  912: 			int dx;
  913: 			int dy;
  914: 
  915: 			/* The left stick moves the menu cursor; zero the game axes. */
  916: 			xboxCursorX += Sys_XboxInputCursorStep(stick[0], frameMs);
  917: 			xboxCursorY += Sys_XboxInputCursorStep(stick[1], frameMs);
  918: 			dx = (int)xboxCursorX;
  919: 			dy = (int)xboxCursorY;
  920: 			xboxCursorX -= (float)dx;
  921: 			xboxCursorY -= (float)dy;
  922: 			if (dx || dy)
  923: 				Com_QueueEvent(time, SE_MOUSE, dx, dy, 0, NULL);
  924: 			memset(stick, 0, sizeof(stick));
  925: 		}
  926: 
  927: 		for (i = 0; i < 4; ++i)
  928: 		{
  929: 			if (stick[i] != xboxSentAxis[port][i])
  930: 			{
  931: 				xboxSentAxis[port][i] = stick[i];
  932: 				Sys_XboxInputAxisEvent(time, i, stick[i]);
  933: 			}
  934: 		}
  935: 	}
  936: 	Sys_XboxHidFrame(time);
  937: }
  938: 
  939: void Sys_XboxInputShutdown(void)
  940: {
  941: 	if (!xboxInputStarted)
  942: 		return;
  943: 	xboxInputStopping = qtrue;
  944: 	{
  945: 		int i, j, time = Sys_Milliseconds();
  946: 		for (i = 0; i < XBOX_HID_MAX_DEVICES; ++i)
  947: 		{
  948: 			for (j = 0; j < 32; ++j)
  949: 			{
  950: 				int bit;
  951: 				for (bit = 0; bit < 8; ++bit)
  952: 					if (xboxHid[i].oldUsages[j] & (1 << bit))
  953: 						Sys_XboxHidKeyEvent(time, (j * 8 + bit) == 53 ? K_CONSOLE : Sys_XboxHidKey((uint8_t)(j * 8 + bit)), qfalse, qfalse);
  954: 			}
  955: 			for (j = 0; j < 4; ++j)
  956: 				Sys_XboxHidKeyEvent(time, xboxHid[i].modifierKeys[j], qfalse, qfalse);
  957: 			for (j = 0; j < 5; ++j)
  958: 				if (xboxHid[i].oldButtons & (1 << j))
  959: 					Sys_XboxInputKey(time, K_MOUSE1 + j, qfalse);
  960: 		}
  961: 	}
  962: 	usbh_install_xid_conn_callback(NULL, NULL);
  963: 	usbh_install_hid_conn_callback(NULL, NULL);
  964: 	usbh_core_deinit();
  965: 	memset(xboxControllers, 0, sizeof(xboxControllers));
  966: 	memset(xboxSentKey, 0, sizeof(xboxSentKey));
  967: 	memset(xboxSentAxis, 0, sizeof(xboxSentAxis));
  968: 	memset(xboxHid, 0, sizeof(xboxHid));
  969: 	xboxInputStarted = qfalse;
  970: }
  971: 
  972: const xboxControllerState_t *Sys_XboxInputState(int port)
  973: {
  974: 	if (port < 0 || port >= XBOX_CONTROLLER_PORTS)
  975: 		return NULL;
  976: 	return &xboxControllers[port];
  977: }

