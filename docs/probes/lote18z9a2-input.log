  746: static void Sys_XboxInputReadComplete(UTR_T *transfer)
  747: {
  748: 	xid_dev_t *device = transfer ? (xid_dev_t *)transfer->context : NULL;
  749: 	xboxControllerState_t *state;
  750: 	xid_gamepad_in report;
  751: 
  752: 	if (!device || !transfer || transfer->status != USBH_OK ||
  753: 		transfer->xfer_len < sizeof(report))
  754: 		return;
  755: 	if (device->xid_desc.bType != XID_TYPE_GAMECONTROLLER)
  756: 		return;
  757: 
  758: 	state = (xboxControllerState_t *)device->user_data;
  759: 	if (!state)
  760: 		return;
  761: 
  762: 	memcpy(&report, transfer->buff, sizeof(report));
  763: 	state->buttons = report.dButtons;
  764: 	state->a = report.a;
  765: 	state->b = report.b;
  766: 	state->x = report.x;
  767: 	state->y = report.y;
  768: 	state->black = report.black;
  769: 	state->white = report.white;
  770: 	state->leftTrigger = report.l;
  771: 	state->rightTrigger = report.r;
  772: 	state->leftStickX = report.leftStickX;
  773: 	state->leftStickY = report.leftStickY;
  774: 	state->rightStickX = report.rightStickX;
  775: 	state->rightStickY = report.rightStickY;
  776: 
  777: 	if (!xboxInputStopping)
  778: 	{
  779: 		/* nxdk's XID path reuses the completed interrupt transfer. */
  780: 		transfer->xfer_len = 0;
  781: 		transfer->bIsTransferDone = 0;
  782: 		(void)usbh_int_xfer(transfer);
  783: 	}
  784: }
  785: 
  786: static void Sys_XboxInputConnected(xid_dev_t *device, int param)
  787: {
  788: 	xboxControllerState_t *state;
  789: 	(void)param;
  790: 
  791: 	if (!device || usbh_xid_get_type(device) == XID_UNKNOWN)
  792: 		return;
  793: 	state = Sys_XboxInputSlot(device);
  794: 	if (state)
  795: 		(void)usbh_xid_read(device, 0, (void *)Sys_XboxInputReadComplete);
  796: }
  797: 
  798: static void Sys_XboxInputDisconnected(xid_dev_t *device, int param)
  799: {
  800: 	xboxControllerState_t *state;
  801: 	(void)param;
  802: 
  803: 	if (!device)
  804: 		return;
  805: 	state = (xboxControllerState_t *)device->user_data;
  806: 	if (state)
  807: 	{
  808: 		memset(state, 0, sizeof(*state));
  809: 		state->connected = qfalse;
  810: 	}
  811: 	device->user_data = NULL;
  812: }
