256: unsigned char *StateScript::FindLabel(const_str label)
257: {
258:     script_label_t *s;
259:     ScriptClass    *scriptClass;
260:     GameScript     *script;
261: 
262:     s = label_list.findKeyValue(label);
263: 
264:     if (s) {
265:         // check if the label is a private function
266:         if (s->isprivate) {
267:             scriptClass = Director.CurrentScriptClass();
268: 
269:             if (scriptClass) {
270:                 script = scriptClass->GetScript();
271: 
272:                 // now check if the label's statescript matches this statescript
273:                 if ((&script->m_State) != this) {
274:                     ScriptError("Cannot call a private function.");
275:                     return NULL;
276:                 }
277:             }
278:         }
279: 
280:         return s->codepos;
281:     } else {
282:         return NULL;
283:     }
284: }
