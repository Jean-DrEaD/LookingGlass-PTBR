## def: code\server\sv_init.c:454
454: void SV_Startup( void ) {
455: 	if ( svs.initialized ) {
456: 		Com_Error( ERR_FATAL, "SV_Startup: svs.initialized already set" );
457: 	}
458: 	SV_BoundMaxClients( 1 );
459: 	SV_ClientsAlloc();
460: 
461: 	svs.initialized = qtrue;
462: 	memset( last_mapname, 0, sizeof( last_mapname ) );
463: 
464: 	SV_InitGamespy();
465: 	Cvar_Set( "sv_running", "1" );
466: 	
467: 	// Join the ipv6 multicast group now that a map is running so clients can scan for us on the local network.
468: 	NET_JoinMulticast6();
469: }
