471: /*
472: ==================
473: SV_NumClients
474: ==================
475: */
476: int SV_NumClients(void) {
477: 	int i;
478: 	int numClients = 0;
479: 
480: 	for (i = 0; i < svs.iNumClients; i++) {
481: 		if (svs.clients[i].state > CS_FREE) {
482: 			++numClients;
483: 		}
484: 	}
485: 
486: 	return numClients;
487: }
