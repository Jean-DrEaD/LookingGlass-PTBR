317: Listener *SpawnArgs::Spawn(void)
318: {
319:     SafePtr<Listener> ent = (Listener *)SpawnInternal();
320:     if (!ent) {
321:         return NULL;
322:     }
323: 
324:     ent->ProcessPendingEvents();
325:     if (!ent) {
326:         // Fixed in OPM
327:         //  Make sure to check the entity after processing events,
328:         //  the ent could be deleted due to a posted remove event
329:         return NULL;
330:     }
331: 
332:     ent->ProcessEvent(EV_Entity_Start);
333: 
334:     return ent;
335: }
