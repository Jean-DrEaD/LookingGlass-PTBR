6: /* LG 18m: fonte dummy nao-NULL (UI faz ERR_DROP se LoadFont retorna NULL) */
7: static fontheader_t lg_null_fonts[16];
8: static int lg_null_nfonts = 0;
9: static fontheader_sgl_t lg_null_sgl[16]; /* LG 18v */
10: static fontheader_t *lg_null_LoadFont(const char *name) {
11:     int i;
12:     for (i = 0; i < lg_null_nfonts; i++) { if (!Q_stricmp(lg_null_fonts[i].name, name)) return &lg_null_fonts[i]; }
13:     if (lg_null_nfonts >= 16) return &lg_null_fonts[0];
14:     Q_strncpyz(lg_null_fonts[lg_null_nfonts].name, name, sizeof(lg_null_fonts[0].name));
15:     { /* LG 18v */
16:         fontheader_t *f = &lg_null_fonts[lg_null_nfonts];
17:         fontheader_sgl_t *s = &lg_null_sgl[lg_null_nfonts];
18:         int c;
19:         memset(s, 0, sizeof(*s));
20:         for (c = 0; c < 256; c++) { s->indirection[c] = c; s->locations[c].size[0] = 8.0f / 256.0f; }
21:         s->height = 16.0f; s->aspectRatio = 1.0f;
22:         Q_strncpyz(s->name, name, sizeof(s->name));
23:         f->numPages = 0; f->sgl[0] = s;
24:     }
25:     return &lg_null_fonts[lg_null_nfonts++];
26: }
