630: qboolean UI_FontDBCSIsLeadByte(fontheader_t *font, unsigned short uch)
631: {
632:     // Byte ranges found in Wikipedia articles with relevant search strings in each case
633:     switch (font->codePage) {
634:     case 932:
635:         // Shift_jis
636:         return ((uch >= 0x81) && (uch <= 0x9F)) || ((uch >= 0xE0) && (uch <= 0xFC));
637:         // Lead bytes F0 to FC may be a Microsoft addition.
638:     case 936:
639:         // GBK
640:         return (uch >= 0x81) && (uch <= 0xFE);
641:     case 949:
642:         // Korean Wansung KS C-5601-1987
643:         return (uch >= 0x81) && (uch <= 0xFE);
644:     case 950:
645:         // Big5
646:         return (uch >= 0x81) && (uch <= 0xFE);
647:     case 1361:
648:         // Korean Johab KS C-5601-1992
649:         return ((uch >= 0x84) && (uch <= 0xD3)) || ((uch >= 0xD8) && (uch <= 0xDE)) || ((uch >= 0xE0) && (uch <= 0xF9));
650:     }
651:     return false;
