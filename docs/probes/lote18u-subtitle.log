548: int UIFont::getCharWidth(unsigned short ch)
549: {
550:     int   index;
551:     int   indirected;
552:     float widthMul = 1.0f; // Added in OPM for easier readability
553: 
554:     CheckRefreshFont();
555: 
556:     if (!m_font) {
557:         return 4;
558:     }
559: 
560:     if (ch == '\t') {
561:         ch       = ' ';
562:         widthMul = 3.0f;
563:     }
564: 
565:     if (m_font->numPages) {
566:         int code = CodeSearch(ch);
567:         if (code < 0) {
568:             return 0;
569:         }
570: 
571:         index      = m_font->charTable[code].index;
572:         indirected = m_font->charTable[code].loc;
573:     } else {
574:         indirected = m_font->sgl[0]->indirection[ch];
575:         if (indirected < 0 || indirected > 255) {
576:             return 0;
577:         }
578: 
579:         index = 0;
580:     }
581: 
582:     return m_font->sgl[index]->locations[indirected].size[0] * 256.0 * widthMul;
583: }
