1269: void Level::ComputeDMWaypoints()
1270: {
1271:     qboolean shouldSetDefaultLandmark;
1272:     float    startXDistMin, startXDistMax;
1273:     float    startYDistMin, startYDistMax;
1274:     int      i;
1275: 
1276:     if (g_gametype->integer == GT_SINGLE_PLAYER) {
1277:         m_fLandmarkXDistMax = 1;
1278:         m_fLandmarkYDistMax = 1;
1279:         m_fLandmarkXDistMin = 0;
1280:         m_fLandmarkYDistMin = 0.0;
1281:         return;
1282:     }
1283: 
1284:     shouldSetDefaultLandmark = qfalse;
1285: 
1286:     //
1287:     // calculate the world bounds from entities
1288:     //
1289:     if (m_fLandmarkXDistMin == m_fLandmarkXDistMax && m_fLandmarkYDistMin == m_fLandmarkYDistMax
1290:         && m_fLandmarkXDistMax == m_fLandmarkYDistMax) {
1291:         shouldSetDefaultLandmark = qtrue;
1292: 
1293:         for (i = 0; i < game.maxentities; i++) {
1294:             gentity_t *ent = &g_entities[i];
1295: 
1296:             if (ent->entity) {
1297:                 AddLandmarkOrigin(ent->entity->origin);
1298:                 shouldSetDefaultLandmark = qfalse;
1299:             }
1300:         }
1301:     }
1302: 
1303:     if (shouldSetDefaultLandmark) {
1304:         startXDistMax = 1;
1305:         startYDistMax = 1;
1306:         startXDistMin = 0;
1307:         startYDistMin = 0;
1308:     } else {
1309:         startYDistMax = m_fLandmarkYDistMax;
1310:         startYDistMin = m_fLandmarkYDistMin;
1311:         startXDistMax = m_fLandmarkXDistMax;
1312:         startXDistMin = m_fLandmarkXDistMin;
1313:     }
1314: 
1315:     m_fLandmarkXDistMin = startXDistMin + (startXDistMax - startXDistMin) / 3.f;
1316:     m_fLandmarkXDistMax = startXDistMin + (startXDistMax - startXDistMin) * 2.f / 3.f;
