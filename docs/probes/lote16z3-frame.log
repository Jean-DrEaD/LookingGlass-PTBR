   276: /*
   277: ==================
   278: SV_GameMap_f
   279: 
   280: Restart the server on a different map
   281: ==================
   282: */
   283: static void SV_GameMap_f( void ) {
   284: 	const char	*map;
   285: 	qboolean	bTransition;
   286: 
   287: 	if( Cmd_Argc() != 2 ) {
   288: 		Com_Printf( "USAGE: gamemap <map>\n" );
   289: 		return;
   290: 	}
   291: 
   292: 	map = Cmd_Argv( 1 );
   293: 	Com_DPrintf( "SV_GameMap(%s)\n", map );
   294: 
   295: 	Q_strncpyz( svs.gameName, "current", sizeof( svs.gameName ) );
   296: 	Cvar_SaveGameRestart_f();
   297: 
   298: 	bTransition = sv.state == SS_GAME;
   299: 
   300: 	// save persistant data
   301: 	if( bTransition ) {
   302: 		SV_ArchivePersistantFile( qfalse );
   303: 	}
   304: 
   305: 	SV_SpawnServer( map, qfalse, qfalse, bTransition );
   306: 
   307: 	if( g_gametype->integer == GT_SINGLE_PLAYER ) {
   308: 		svs.autosave = qtrue;
   309: 	}
   310: }
