   1138: 	retval = _vsnprintf(str, size, format, ap);
   1139: 
   1140: 	if (retval < 0 || retval == size)
   1141: 	{
   1142: 		// Microsoft doesn't adhere to the C99 standard of vsnprintf,
   1143: 		// which states that the return value must be the number of
   1144: 		// bytes written if the output string had sufficient length.
   1145: 		//
   1146: 		// Obviously we cannot determine that value from Microsoft's
   1147: 		// implementation, so we have no choice but to return size.
   1148: 
   1149: 		str[size - 1] = '\0';
   1150: 		return size;
   1151: 	}
   1152: 
