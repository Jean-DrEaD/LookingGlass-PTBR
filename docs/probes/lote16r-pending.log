## corepp\listener.cpp:3532
3532: qboolean Listener::ProcessPendingEvents(void)
3533: {
3534:     EventQueueNode *event;
3535:     qboolean        processedEvents;
3536:     float           t;
3537: 
3538:     processedEvents = false;
3539: 
3540:     t = EVENT_msec;
3541: 
3542:     Listener::ProcessingEvents = true;
3543: 
3544:     event = Event::EventQueue.next;
3545:     while (event != &Event::EventQueue) {
3546:         Listener *obj;
3547: 
3548:         assert(event);
3549: 
3550:         obj = event->GetSourceObject();
3551: 
3552:         if (event->inttime > t) {
3553:             break;
3554:         }
3555: 
3556:         if (obj != this) {
3557:             // traverse normally
3558:             event = event->next;
3559:         } else {
3560:             // the event is removed from its list and temporarily added to the active list
3561:             LL_Remove(event, next, prev);
3562: 
3563:             // ProcessEvent will dispose of this event when it is done
3564:             obj->ProcessEvent(event->event);
3565: 
3566:             // free up the node
3567:             delete event;
3568: 
3569:             // start over, since can't guarantee that we didn't process any previous or following events
3570:             event = Event::EventQueue.next;
3571: 
3572:             processedEvents = true;
3573:         }
3574:     }
3575: 
3576:     Listener::ProcessingEvents = false;
3577: 
3578:     return processedEvents;
3579: }
