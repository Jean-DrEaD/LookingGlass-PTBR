576: void L_ProcessPendingEvents()
577: {
578:     EventQueueNode *node;
579: 
580:     Listener::ProcessingEvents = true;
581: 
582:     int t = EVENT_msec;
583:     while (!LL_Empty(&Event::EventQueue, next, prev)) {
584:         Listener *obj;
585: 
586:         node = Event::EventQueue.next;
587: 
588:         assert(node);
589: 
590:         obj = node->GetSourceObject();
591: 
592:         assert(obj);
593: 
594:         if (node->inttime > t) {
595:             break;
596:         }
597: 
598:         // the event is removed from its list
599:         LL_Remove(node, next, prev);
600:         //gi.DPrintf2("Event: %s\n", node->event->getName().c_str());
601: 
602:         // ProcessEvent will dispose of this event when it is done
603:         obj->ProcessEvent(node->event);
604: 
605:         delete node;
606:     }
607: 
608:     Listener::ProcessingEvents = false;
609: }
