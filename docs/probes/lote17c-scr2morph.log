Centipede1_Cinematics_Init:
	waitthread Init_Dialog
	$cam load "centipede1_path1"
	$centipede_actor1 maxmouthangle 45
	$centipede_actor1 ai_off
	$centipede_actor1 hide
	$ant_runner1 ai_off
	$ant_runner2 ai_off
	$ant_runner3 ai_off
end

Centipede1_Brave_Killer_Killed:
	level.brave_killer = (level.brave_killer - 1)
end

Centipede1_Brave_Killer:
	while (1)
	{
		if ((level.brave_ants < 3))
		{
			trigger $brave_killer1
			wait 0.1
			level.brave_killer = (level.brave_killer + 1)
			$ant_killer killthread "Centipede1_Brave_Killer_Killed"
			$ant_killer attackplayer
		}
		wait 3.0
	}
end

Centipede1_Brave_Ants_Killed:
	level.brave_ants = (level.brave_ants - 1)
end

Centipede1_Brave_Ants:
	while (1)
	{
		if ((level.brave_ants < 3))
		{
			trigger $brave_spawn1
			wait 0.1
			level.brave_ants = (level.brave_ants + 1)
			$ant_attack killthread "Centipede1_Brave_Ants_Killed"
			$ant_attack attackplayer
		}
		wait 3.0
	}
end

Centipede1_BraveAttack:
	$ant_runner1 runto_pathnode "$ant_brave_pos1"
	$ant_runner2 runto_pathnode "$ant_brave_pos2"
	$ant_runner3 runto_pathnode "$ant_brave_pos3"
end

Centipede1_Talk1:
	$dialogtext dt_clear
	$dialogtext dt_fadetime 4
	$centipede_actor1 playdialog "sound/character/centipede/vo/cpd001.wav"
	waitForDialog $centipede_actor1 1
end

Centipede1_Cinematic_Fakeplayer:
	$player hideweapon 1
	fakeplayer
	$fakeplayer rendereffects "+betterlighting"
end

Centipede1_CentAnims:
	$centipede_actor1 anim "idle_yawn"
	waitfor $centipede_actor1
	$centipede_actor1 anim "idle_snarl"
	waitfor $centipede_actor1
end

C1_End:
	level_ai 0
	cam_fadeout 0.5 1 1 1 1 0
	wait 0.5
	$centipede_actor1 remove
	waitthread End_Cinematic_Fast
	cam_fadein 0.5 1 1 1 1 0
	level_ai 1
	$ant_runner1 ai_on
	$ant_runner2 ai_on
	$ant_runner3 ai_on
	$player minhealth 10
	trigger $ant_at_end1
	trigger $ant_at_end2
	thread Centipede1_Brave_Ants
	thread Centipede1_Brave_Killer
	wait 4
	map "centipede2$centipede2_start1"
end

Skipthread_C1:
	skipthread "Null"
	killthread "Centipede1_Ambush_Cinema1"
	killthread "Centipede1_CentAnims"
	thread C1_End
end

Centipede1_Ambush_Cinema1:
	level_ai 0
	$ant_runner1 runto_pathnode "$ant_brave_pos1"
	$ant_runner2 runto_pathnode "$ant_brave_pos2"
	$ant_runner3 runto_pathnode "$ant_brave_pos3"
	wait 2
	waitthread Centipede1_Cinematic_Fakeplayer
	waitthread Start_Cinematic
	skipthread "Skipthread_C1"
	wait 0.5
	cam_fadeout 0.5 1 1 1 1 0
	wait 0.5
	$centipede_actor1 show
	$centipede_actor1 warpto "$cent_posx1"
	$alice_watch1 follow $centipede1_path1
	$alice_watch1 cut
	cuecamera $alice_watch1 0
	cam_fadein 0.5 1 1 1 1 0
	thread Centipede1_CentAnims
	$dialogtext dt_clear
	$dialogtext dt_fadetime 4
	$centipede_actor1 playdialog "sound/character/centipede/vo/cpd002.wav"
	waitForDialog $centipede_actor1 1
	cam_fadeout 0.5 1 1 1 1 0
	wait 0.5
	$centipede_actor1 remove
	cam_fadein 0.5 1 1 1 1 0
	waitthread End_Cinematic_Fast
	level_ai 1
	$ant_runner1 ai_on
	$ant_runner2 ai_on
	$ant_runner3 ai_on
	$player minhealth 10
	thread Centipede1_Brave_Ants
	thread Centipede1_Brave_Killer
	wait 10
	map "centipede2$centipede2_start1"
end

ArmLadies:
	local.bugname = ""
	local.i = 0
	while (1)
	{
		for (local.i = 1 ; (local.i < 5) ; local.i++)
		{
			local.bugname = ("lady" + local.i)
			local.bug = $(local.bugname)
			local.bug checkreload
		}
		wait 2
	}
end

Centipede1_Enemies_Init:
	thread ArmLadies
end

Centipede1_Move_Enemies:
	$lady1 followspline "$t9" "loop" "normalangles"
	$lady2 followspline "$t48" "loop" "normalangles"
	$lady3 followspline "$t18" "loop" "normalangles"
	$lady4 followspline "$t26" "loop" "normalangles"
end

Centipede1_Pre_Init:
	$c1_changelevel nottriggerable
end

main:
	thread Centipede1_Enemies_Init
	thread Func_Sound_Init
	thread Centipede1_Cinematics_Init
	thread Centipede1_Pre_Init
	soundtrack "sound/music/centipede1.mus"
	drugview 0
	waitForPlayer
	thread Centipede1_Move_Enemies
	music "normal" "normal"
end

