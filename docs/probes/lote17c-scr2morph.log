setfarplane local.newcolor local.fdistance:
	level.fog_color = local.newcolor
	level.fog_distance = local.fdistance
	$world farplane_color level.fog_color
	$world farplane level.fog_distance
end

fadefog local.newcolor local.newdistance local.fogfadetime:
	local.i = 0
	local.n = 0
	local.frontlerp = 0
	local.backlerp = 0
	local.oldcolor = ( 0 0 0 )
	local.olddist = 0
	local.oldcolor = level.fog_color
	local.olddist = level.fog_distance
	local.n = (local.fogfadetime / 0.05)
	for (local.i = 0 ; (local.i < local.n) ; local.i++)
	{
		local.frontlerp = (local.i / local.n)
		local.backlerp = (1.0 - local.frontlerp)
		level.fog_color = ((local.oldcolor * local.backlerp) + (local.newcolor * local.frontlerp))
		level.fog_distance = ((local.olddist * local.backlerp) + (local.newdistance * local.frontlerp))
		$world farplane_color level.fog_color
		$world farplane level.fog_distance
		wait 0.05
	}
	$world farplane_color local.newcolor
	$world farplane local.newdistance
end

FlipMove local.org local.tile local.destination local.rot local.height local.movetime:
	local.vel = 0
	local.acc = 0
	local.t = 0
	local.dist = 0
	local.endtime = 0
	local.r = ( 0 0 0 )
	local.t = (0.1 / local.movetime)
	local.vel = ((2 * local.t) * (local.height - (local.height * local.t)))
	local.acc = (local.vel * local.t)
	local.r = (local.rot * (local.t * 0.5))
	local.endtime = (local.movetime * 20)
	local.org time local.movetime
	local.org movetoent local.destination
	local.tile time 0.05
	for (local.t = 0 ; (local.t < local.endtime) ; local.t++)
	{
		local.dist = (local.dist + local.vel)
		local.tile rotateto (local.r * local.t)
		local.tile playsound "sound/ambience/special/flip1.wav"
		local.tile moveUp local.vel
		waitfor local.tile
		local.vel = (local.vel - local.acc)
	}
	if (local.dist)
	{
		local.tile moveDown local.dist
		local.tile rotateto local.rot
		waitfor local.tile
	}
end

shrink_alice:
	wait 0.1
	$player god 0
	freezeplayer
	fakeplayer
	$fakeplayer anim "death_falling"
	local.scalecount = 1
	for (local.scalecount = 1 ; (local.scalecount > 0) ; local.scalecount = (local.scalecount - 0.05))
	{
		$fakeplayer scale local.scalecount
		wait 0.1
	}
	$fakeplayer hide
	$player hide
	$player health 0
	$player dead
end

