532: static uint32_t *XboxNV2ABindTexture(uint32_t *p, unsigned int unit, int imageIndex,
533: 	qboolean clamp)
534: {
535: 	const XboxNV2AImage *image = &xboxNV2AImages[imageIndex];
536: 	XguTextureAddress address = clamp ? XGU_CLAMP_TO_EDGE : XGU_WRAP;
537: 	int levels = image->levels > 1 ? image->levels : 1;
538: 
539: 	if (imageIndex == xboxNV2ABoundImage[unit] && clamp == xboxNV2ABoundClamp[unit])
540: 		return p;
541: 	p = xgu_set_texture_offset(p, unit, (void *)((uint32_t)image->memory & 0x03ffffff));
542: 	p = xgu_set_texture_format(p, unit, 2, false, XGU_SOURCE_COLOR, 2, image->format,
543: 		(uint8_t)levels, XboxNV2ALog2(image->width), XboxNV2ALog2(image->height), 0);
544: 	/* U, V and P must all hold a valid mode; 0 raises a GPU invalid-data error. */
545: 	p = xgu_set_texture_address(p, unit, address, false, address, false, address, false,
546: 		false);
547: 	/* The format's level count limits the LOD, so the clamp stays wide open, as in pbgl. */
548: 	p = xgu_set_texture_control0(p, unit, true, 0, XBOX_NV2A_MAX_LOD_CLAMP);
549: 	p = xgu_set_texture_filter(p, unit, 0, XGU_TEXTURE_CONVOLUTION_QUINCUNX,
550: 		levels > 1 ? XBOX_NV2A_FILTER_MIPMAP : XBOX_NV2A_FILTER_LINEAR, XBOX_NV2A_FILTER_LINEAR,
551: 		false, false, false, false);
552: 	xboxNV2ABoundImage[unit] = imageIndex;
553: 	xboxNV2ABoundClamp[unit] = clamp;
554: 	return p;
555: }
