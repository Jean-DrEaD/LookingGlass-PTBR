622: static void XboxNV2ASetTransform(const XguVec4 *rows, qboolean identity)
623: {
624: 	XguVec4 screen[4];
625: 	uint32_t *p;
626: 	int i;
627: 
628: 	/* Overscan scale and offset in screen space, times clip w so the divide keeps the offset. */
629: 	for (i = 0; i < 4; ++i) {
630: 		screen[i] = rows[i];
631: 		screen[i].f[0] = rows[i].f[0] * xboxNV2AScreenScaleX + rows[i].f[3] * xboxNV2AScreenX;
632: 		screen[i].f[1] = rows[i].f[1] * xboxNV2AScreenScaleY + rows[i].f[3] * xboxNV2AScreenY;
633: 	}
634: 	XboxNV2AReserve(24);
635: 	p = pb_begin();
636: 	p = xgu_set_transform_constant_load(p, 96);
637: 	p = xgu_set_transform_constant(p, screen, 4);
638: 	pb_end(p);
639: 	xboxNV2ATransformIdentity = identity;
640: 	/* Row vectors: clip w is the dot product of (x, y, z, 1) with column 3. */
641: 	xboxNV2ANearPlane[0] = rows[0].f[3];
642: 	xboxNV2ANearPlane[1] = rows[1].f[3];
643: 	xboxNV2ANearPlane[2] = rows[2].f[3];
644: 	xboxNV2ANearPlane[3] = rows[3].f[3] - XBOX_NV2A_ZNEAR;
645: }
