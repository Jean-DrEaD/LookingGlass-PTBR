514: static XguBlendFactor XboxNV2ABlendFactor(unsigned int factor)
515: {
516: 	switch (factor) {
517: 	case GL_ZERO: return XGU_FACTOR_ZERO;
518: 	case GL_ONE: return XGU_FACTOR_ONE;
519: 	case GL_SRC_COLOR: return XGU_FACTOR_SRC_COLOR;
520: 	case GL_ONE_MINUS_SRC_COLOR: return XGU_FACTOR_ONE_MINUS_SRC_COLOR;
521: 	case GL_SRC_ALPHA: return XGU_FACTOR_SRC_ALPHA;
522: 	case GL_ONE_MINUS_SRC_ALPHA: return XGU_FACTOR_ONE_MINUS_SRC_ALPHA;
523: 	case GL_DST_ALPHA: return XGU_FACTOR_DST_ALPHA;
524: 	case GL_ONE_MINUS_DST_ALPHA: return XGU_FACTOR_ONE_MINUS_DST_ALPHA;
525: 	case GL_DST_COLOR: return XGU_FACTOR_DST_COLOR;
526: 	case GL_ONE_MINUS_DST_COLOR: return XGU_FACTOR_ONE_MINUS_DST_COLOR;
527: 	case GL_SRC_ALPHA_SATURATE: return XGU_FACTOR_SRC_ALPHA_SATURATE;
528: 	default: return XGU_FACTOR_ONE;
529: 	}
530: }
