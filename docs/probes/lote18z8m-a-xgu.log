557: /* 2D stages never touch depth or culling; image1 is a collapsed second stage's, else white. */
558: static void XboxNV2AApplyStageState(const xboxNV2AStage_t *stage, int imageIndex,
559: 	int image1, qboolean clamp1, qboolean is3D, qboolean depthTest, int cull,
560: 	qboolean polygonOffset)
561: {
562: 	int depthWrite = depthTest && stage->depthWrite;
563: 	int depthEqual = depthTest && stage->depthEqual;
564: 	int offset = depthTest && polygonOffset;
565: 	uint32_t *p;
566: 
567: 	if (!is3D)
568: 		cull = XBOX_NV2A_CULL_NONE;
569: 
570: 	XboxNV2AReserve(XBOX_NV2A_STATE_DWORDS);
571: 	p = pb_begin();
572: 	p = XboxNV2ABindTexture(p, 0, imageIndex, stage->clamp);
573: 	p = XboxNV2ABindTexture(p, 1, image1, clamp1);
574: 	if (stage->srcBlend != xboxNV2ABoundSrcBlend ||
575: 		stage->dstBlend != xboxNV2ABoundDstBlend) {
576: 		p = xgu_set_blend_func_sfactor(p, XboxNV2ABlendFactor(stage->srcBlend));
577: 		p = xgu_set_blend_func_dfactor(p, XboxNV2ABlendFactor(stage->dstBlend));
578: 		xboxNV2ABoundSrcBlend = stage->srcBlend;
579: 		xboxNV2ABoundDstBlend = stage->dstBlend;
580: 	}
581: 	if (stage->alphaFunc != xboxNV2ABoundAlphaFunc) {
582: 		p = xgu_set_alpha_test_enable(p, stage->alphaFunc != XBOX_NV2A_ALPHA_NONE);
583: 		if (stage->alphaFunc == XBOX_NV2A_ALPHA_GT0) {
584: 			p = xgu_set_alpha_func(p, XGU_FUNC_GREATER);
585: 			p = xgu_set_alpha_ref(p, 0);
586: 		} else if (stage->alphaFunc == XBOX_NV2A_ALPHA_LT128) {
587: 			p = xgu_set_alpha_func(p, XGU_FUNC_LESS);
588: 			p = xgu_set_alpha_ref(p, 128);
589: 		} else if (stage->alphaFunc == XBOX_NV2A_ALPHA_GE128) {
590: 			p = xgu_set_alpha_func(p, XGU_FUNC_GREATER_OR_EQUAL);
591: 			p = xgu_set_alpha_ref(p, 128);
592: 		}
593: 		xboxNV2ABoundAlphaFunc = stage->alphaFunc;
594: 	}
595: 	if ((int)depthTest != xboxNV2ABoundDepthTest) {
596: 		p = xgu_set_depth_test_enable(p, depthTest);
597: 		xboxNV2ABoundDepthTest = depthTest;
598: 	}
599: 	if (depthWrite != xboxNV2ABoundDepthWrite) {
600: 		p = xgu_set_depth_mask(p, depthWrite);
601: 		xboxNV2ABoundDepthWrite = depthWrite;
602: 	}
603: 	if (depthEqual != xboxNV2ABoundDepthEqual) {
604: 		p = xgu_set_depth_func(p, depthEqual ? XGU_FUNC_EQUAL : XGU_FUNC_LESS_OR_EQUAL);
605: 		xboxNV2ABoundDepthEqual = depthEqual;
606: 	}
607: 	/* ioq3 GL_Cull: front-sided shaders cull GL_FRONT with the default CCW front face. */
608: 	if (cull != xboxNV2ABoundCull) {
609: 		p = xgu_set_cull_face_enable(p, cull != XBOX_NV2A_CULL_NONE);
610: 		if (cull != XBOX_NV2A_CULL_NONE)
611: 			p = xgu_set_cull_face(p, cull == XBOX_NV2A_CULL_FRONT ? XGU_CULL_FRONT :
612: 				XGU_CULL_BACK);
613: 		xboxNV2ABoundCull = cull;
614: 	}
615: 	if (offset != xboxNV2ABoundPolygonOffset) {
616: 		p = push_command_boolean(p, NV097_SET_POLY_OFFSET_FILL_ENABLE, offset);
617: 		xboxNV2ABoundPolygonOffset = offset;
618: 	}
619: 	pb_end(p);
620: }
