1132: /* xgux_draw_arrays splits the draw into DRAW_ARRAYS packets of 120 vertices. */
1133: static void XboxNV2ADrawVertices(XguPrimitiveType mode, unsigned int first,
1134: 	unsigned int count)
1135: {
1136: 	uint32_t *p;
1137: 
1138: 	XboxNV2AReserve(8 + (count / 120 + 1) * 2);
1139: 	/* The vertex cache survives frames; drop lines fetched before the CPU rewrote them. */
1140: 	p = pb_begin();
1141: 	p = push_command_parameter(p, NV097_BREAK_VERTEX_BUFFER_CACHE, 0);
1142: 	pb_end(p);
1143: 	xgux_draw_arrays(mode, first, count);
1144: 	xboxNV2APerf.draws++;
1145: 	xboxNV2APerf.verts += count;
1146: }
