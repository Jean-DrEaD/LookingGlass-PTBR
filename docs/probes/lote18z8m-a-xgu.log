647: static uint16_t XboxNV2APackTexel(const byte *rgba, XguTexFormatColor format)
648: {
649: 	if (format == XGU_TEXTURE_FORMAT_R5G6B5_SWIZZLED)
650: 		return (uint16_t)(((rgba[0] >> 3) << 11) | ((rgba[1] >> 2) << 5) |
651: 			(rgba[2] >> 3));
652: 	return (uint16_t)(((rgba[3] >> 4) << 12) | ((rgba[0] >> 4) << 8) |
653: 		((rgba[1] >> 4) << 4) | (rgba[2] >> 4));
654: }
