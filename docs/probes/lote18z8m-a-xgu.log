502: /* ioq3 EvalWaveForm; noise needs ioq3's noise table, so it holds its base value. */
503: static float XboxNV2AEvalWave(const xboxNV2AWave_t *wave, double time)
504: {
505: 	int index;
506: 
507: 	if (wave->func == XBOX_NV2A_WAVE_NOISE)
508: 		return wave->base;
509: 	index = (int)((wave->phase + time * wave->frequency) * XBOX_NV2A_FUNCTABLE_SIZE);
510: 	return wave->base + XboxNV2AWaveTable(wave->func)[index & XBOX_NV2A_FUNCTABLE_MASK] *
511: 		wave->amplitude;
512: }
