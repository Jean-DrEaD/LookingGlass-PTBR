2355: 		PAGE_WRITECOMBINE | PAGE_READWRITE);
2356: 	xboxNV2AVertexMemory = MmAllocateContiguousMemoryEx(
2357: 		XBOX_NV2A_MAX_VERTS * sizeof(XboxNV2AColoredVertex), 0,
2358: 		XBOX_NV2A_MAX_RAM, 0, PAGE_WRITECOMBINE | PAGE_READWRITE);
